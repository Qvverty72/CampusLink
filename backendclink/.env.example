PORT=3000
# Published port with Docker Compose; the internal port remains 3000.
HOST_PORT=3000
NODE_ENV=development
MONGODB_URI=
MONGODB_DB_NAME=campuslink
# Optional DNS override for Atlas SRV/TXT in Node, including inside Docker.
# Empty uses the container/system DNS; choose resolvers allowed by your network.
# Example: MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
MONGODB_DNS_SERVERS=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Required by institutional registration persistence/catalog; optional for basic Auth identity/probes.
# Never expose it to Expo. SUPABASE_SERVICE_ROLE_KEY is also accepted as a legacy alias.
SUPABASE_SECRET_KEY=
# PostgreSQL/pooler URL from Supabase Connect; required to save the academic profile.
# Contains the DATABASE password, not the Auth API key. Backend only.
# Remote TLS is verified; use no SSL mode or sslmode=verify-full (sslrootcert if needed).
SUPABASE_DB_URL=
DATABASE_TIMEOUT_MS=5000
HEALTH_DIAGNOSTICS_ENABLED=false
HEALTH_CACHE_TTL_MS=5000
