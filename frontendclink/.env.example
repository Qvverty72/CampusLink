
# Cambiar por IP de ipconfig
EXPO_PUBLIC_API_URL=http://192.xxx.x.xx:3000
EXPO_PUBLIC_SUPABASE_URL=
# Solo clave pública. Nunca secret/service_role en variables EXPO_PUBLIC_*.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alias legado opcional; se prefiere PUBLISHABLE_KEY.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

