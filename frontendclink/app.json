{
  "expo": {
    "name": "CampusLink",
    "slug": "campuslink",
    "scheme": "campuslink",
    "userInterfaceStyle": "automatic",
    "web": {
      "output": "single"
    },
    "plugins": [
      ["expo-router", { "asyncRoutes": { "web": false } }],
      "expo-asset",
      "@react-native-community/datetimepicker",
      ["expo-image-picker", {
        "photosPermission": "Permite a CampusLink seleccionar la fotografía del recurso que quieres publicar.",
        "cameraPermission": false,
        "microphonePermission": false
      }],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
